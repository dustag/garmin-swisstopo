# Copy to .env and adapt to your machine.

# Downloaded and intermediate data (~16 GB for swissTLM3D): keep it out of synced folders
DATA_DIR=~/swisstopo-data
# Generated .img files (default: $DATA_DIR/output)
#OUTPUT_DIR=~/swisstopo-data/output
# mkgmap location (default: ./tools)
#TOOLS_DIR=./tools

# Java executable (default: java from PATH)
#JAVA_EXE=C:\Program Files\Eclipse Adoptium\jdk-25.0.5.8-hotspot\bin\java.exe
#JAVA_MAX_HEAP=4g

# Coverage to build: an area name of config.AREAS (telliers, chavornay), switzerland,
# canton:XX[,YY], dept:NN[,MM] (France), it:XX[,YY] or it (Italy) or bbox:E0,N0,E1,N1
# (LV95 metres); several can be joined with "+", e.g. canton:VS+dept:74 or switzerland+dept:74+it
COVERAGE=telliers

# Label language: fr, de, it, rm or en (place names keep their official local form)
LANG_LABELS=fr

# French departments whose data is used next to the Swiss data (comma-separated)
FRANCE_DEPTS=74

# Italian zones whose data is used: provinces by their ISTAT abbreviation, and GP for the
# Piedmont side of the Gran Paradiso (comma-separated)
ITALY_ZONES=AO,VB,VA,CO,SO,BZ,GP
