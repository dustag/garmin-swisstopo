# Copy to .env and adapt to your machine.

# Downloaded and intermediate data (~16 GB for swissTLM3D): keep it out of synced folders
DATA_DIR=~/swisstopo-data
# Generated .img files (default: $DATA_DIR/output)
#OUTPUT_DIR=~/swisstopo-data/output
# mkgmap location (default: ./tools)
#TOOLS_DIR=./tools

# Java executable (default: java from PATH)
#JAVA_EXE=C:\Program Files\Eclipse Adoptium\jdk-25.0.5.8-hotspot\bin\java.exe
#JAVA_MAX_HEAP=4g

# Coverage to build: an area name of config.AREAS (telliers, chavornay), switzerland,
# canton:XX[,YY], dept:NN[,MM] (France), it:XX[,YY], at:XX, de:XX, es:XX (zones below), it, at,
# de, es, ad (all the zones of a country), bbox:E0,N0,E1,N1 (LV95 metres), or a region: alpes-ouest,
# alpes-est, jura, pyrenees; several can be joined with "+", e.g. canton:VS+dept:74
COVERAGE=telliers

# Label language: fr, de, it or en (place names keep their official local form)
LANG_LABELS=fr

# Zones whose data is used, comma-separated (default: those of the regions, see config.REGIONS):
# French departments, Italian provinces (or GP), Austrian, German and Spanish NUTS 3 regions, AD
#FRANCE_DEPTS=74,73,38,05,04,06,26,83,84,25,39,01,64,65,31,09,66
#ITALY_ZONES=AO,VB,VA,CO,TO,CN,BI,VC,NO,IM,SV,SO,BZ,LC,BG,BS,TN,VR,VI,BL,TV,PN,UD,GO
#AUSTRIA_ZONES=AT341,AT342,AT331,...
#GERMANY_ZONES=DE27E,DE27A,DE273
#SPAIN_ZONES=ES220,ES241,ES513,ES512
#ANDORRA_ZONES=AD
